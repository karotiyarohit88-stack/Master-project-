# ==============================================================================
# MASTER PROJECT AI AGENT — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to '.env' for local development and replace placeholders locally.
# NEVER put real API keys, passwords, tokens, or production URLs in this file.
# .env is ignored by Git; this example template is intentionally tracked.
# ==============================================================================

# 1. GOOGLE GEMINI AI (existing key name retained)
GEMINI_API_KEY="your_gemini_api_key_here"

# 2. OPENAI (existing key name retained)
OPENAI_API_KEY="your_openai_api_key_here"

# 3. GITHUB (existing key name retained)
GITHUB_TOKEN="your_github_personal_access_token_here"
GITHUB_OWNER="karotiyarohit88"
GITHUB_REPO="master-project-ai-agent"
GITHUB_BRANCH="main"
# Optional legacy compatibility alias; prefer GITHUB_TOKEN.
GH_TOKEN=""

# 4. ELEVENLABS VOICE (existing key name retained)
ELEVENLABS_API_KEY="your_elevenlabs_api_key_here"

# 5. RUNWAY / VIDEO PROVIDER (existing key name retained)
RUNWAY_API_KEY="your_runway_api_key_here"
VIDEO_PROVIDER_API_KEY=""
VIDEO_PROVIDER_ENDPOINT="https://api.runwayml.com/v1"
VIDEO_PROVIDER_NAME="Runway Gen-3"

# 6. N8N AND PUBLISHING WEBHOOKS
N8N_WEBHOOK_URL="https://your-n8n-instance.example/webhook/replace-me"
N8N_API_KEY="your_n8n_api_key_here"
N8N_AUTH_TOKEN=""
PUBLISHING_WEBHOOK_URL="https://your-publishing-provider.example/webhook/replace-me"
PUBLISHING_API_KEY="your_publishing_provider_key_here"
AUTOPILOT_WEBHOOK_SECRET="replace_with_a_random_webhook_secret"

# 7. GOOGLE WORKSPACE
GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_oauth_client_secret"
GOOGLE_OAUTH_TOKEN=""
GOOGLE_SHEETS_ID="your_google_spreadsheet_id_here"
GOOGLE_SHEETS_KEY="your_google_service_account_private_key_or_api_key"

# 8. DATABASE
# Local-development example only. Replace locally; never commit a real DB URL.
DATABASE_URL="postgresql://user:password@localhost:5432/master_project_db"
# Compatibility fallback; DATABASE_URL takes precedence.
POSTGRES_URL=""
PG_POOL_MAX=10
PG_CONNECTION_TIMEOUT_MS=5000
RUN_DB_MIGRATIONS=false

# 9. AUTHENTICATION, EMAIL OTP, AND SECRET MANAGER
# Generate random values locally / in your secret manager. Never paste real values here.
AAKSH_ADMIN_TOKEN="replace_with_a_random_secret_at_least_32_characters"
AAKSH_OTP_PEPPER="replace_with_a_long_random_otp_pepper"
RESEND_API_KEY="your_resend_api_key_here"
RESEND_FROM_EMAIL="verified-sender@example.com"
# AES-256-GCM key: exactly 32 random bytes encoded as base64 (or 64 hex characters).
AAKSH_SECRETS_ENCRYPTION_KEY="replace_with_32_random_bytes_encoded_as_base64"

# 10. OPTIONAL FIREBASE CONFIGURATION
FIREBASE_CONFIG=""

# 11. SERVER
NODE_ENV="development"
PORT=3000
APP_URL="http://localhost:3000"
