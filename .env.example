# ==============================================================================
# MASTER PROJECT AI AGENT — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to '.env' and fill in your actual API keys & endpoints.
# NEVER commit your '.env' file or secret keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI AI CONFIGURATION (PRIMARY AI MODEL ENGINE)
# Required for AI Chat, reasoning, code analysis, and task orchestration.
# Google AI Studio injects GEMINI_API_KEY at runtime if set in UI Secrets.
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your_gemini_api_key_here"

# ------------------------------------------------------------------------------
# 2. OPENAI API CONFIGURATION (OPTIONAL / ALTERNATE AI ENGINE)
# Used if OpenAI model integrations or fallback pipelines are enabled.
# ------------------------------------------------------------------------------
OPENAI_API_KEY="your_openai_api_key_here"

# ------------------------------------------------------------------------------
# 3. GITHUB INTEGRATION & CODE EXPLORER
# Required for live GitHub API synchronization, repository inspection, and PR proposals.
# Requires Personal Access Token (PAT) with 'repo' scope.
# ------------------------------------------------------------------------------
GITHUB_TOKEN="your_github_personal_access_token_here"
GITHUB_OWNER="karotiyarohit88"
GITHUB_REPO="master-project-ai-agent"
GITHUB_BRANCH="main"

# ------------------------------------------------------------------------------
# 4. ELEVENLABS VOICE STUDIO (TEXT-TO-SPEECH)
# Required for ultra-realistic multi-speaker voice synthesis and voiceover clips.
# ------------------------------------------------------------------------------
ELEVENLABS_API_KEY="your_elevenlabs_api_key_here"

# ------------------------------------------------------------------------------
# 5. RUNWAY GEN-3 / AI VIDEO GENERATOR PIPELINE
# Required for AI video shorts generation, video scene rendering, and video adapters.
# ------------------------------------------------------------------------------
RUNWAY_API_KEY="your_runway_api_key_here"
VIDEO_PROVIDER_ENDPOINT="https://api.runwayml.com/v1"
VIDEO_PROVIDER_NAME="Runway Gen-3"

# ------------------------------------------------------------------------------
# 6. N8N WORKFLOW AUTOMATION & WEBHOOKS
# Required for autonomous workflow execution, external triggers, and webhooks.
# ------------------------------------------------------------------------------
N8N_WEBHOOK_URL="https://your-n8n-instance.com/webhook/your-webhook-id"
N8N_API_KEY="your_n8n_api_key_or_auth_header_here"

# ------------------------------------------------------------------------------
# 7. GOOGLE WORKSPACE OAUTH & GOOGLE SHEETS INTEGRATION
# Used for Google Sheets telemetry sync, Gmail briefings, and Google Workspace integrations.
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_oauth_client_secret"
GOOGLE_SHEETS_ID="your_google_spreadsheet_id_here"
GOOGLE_SHEETS_KEY="your_google_service_account_private_key_or_api_key"

# ------------------------------------------------------------------------------
# 8. DATABASE & AUTHENTICATION PROVIDERS
# Used for persistent relational/document storage and Firebase authentication gates.
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/master_project_db"
POSTGRES_URL="postgresql://user:password@localhost:5432/master_project_db"
FIREBASE_CONFIG="your_firebase_config_json_string_here"

# ------------------------------------------------------------------------------
# 9. APPLET ENVIRONMENT & SERVER PORT
# Default port for development server is 3000.
# ------------------------------------------------------------------------------
PORT=3000
APP_URL="http://localhost:3000"
